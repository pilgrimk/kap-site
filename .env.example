# Resend — contact form delivery
# Create an API key at https://resend.com/api-keys
# Put the real key in .env.local (gitignored). Never commit it here.
RESEND_API_KEY=

# Sender address. Must be on a domain you have verified in Resend.
# Resend recommends a transactional subdomain (e.g. contact.kap-enterprises-llc.com)
# rather than the bare domain, so marketing/transactional sending is isolated
# from your main email reputation.
# Use onboarding@resend.dev for initial testing before your domain is verified.
RESEND_FROM=noreply@contact.kap-enterprises-llc.com

# Inbox that receives contact form submissions. Can be any address — no
# domain verification required on the receiving side.
RESEND_TO=sales@kap-enterprises-llc.com

# Stripe — payment processing
# Get keys from https://dashboard.stripe.com/apikeys
# Publishable key (pk_*) is safe to expose client-side — embedded in browser JS.
# Secret key (sk_*) is NOT safe — gives full API access. Put it in .env.local only,
# NEVER in .env.example, source code, or chat transcripts.
# For development, prefer pk_test_/sk_test_ keys; use pk_live_/sk_live_ only in production.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
